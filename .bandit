# Bandit security configuration
# Reference: https://bandit.readthedocs.io/en/latest/config.html

assert_used:
  skips: ['*/test*.py']

exclude_dirs:
  - /test
  - /tests
  - '*/test_*.py'

# Severity levels: LOW, MEDIUM, HIGH
# Confidence levels: LOW, MEDIUM, HIGH

# Tests to exclude
skips:
  - B101  # assert_used - OK for tests
